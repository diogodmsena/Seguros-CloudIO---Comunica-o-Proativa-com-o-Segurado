# Configurações de Modelos de Linguagem (Opcionais)
# O sistema funciona 100% de forma autônoma mesmo sem chaves (usando o Motor Didático Local).
# Se desejar usar APIs externas em nuvem, descomente e preencha as chaves abaixo:

# Google Gemini API Key (Obtenha gratuitamente no Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (https://platform.openai.com/)
OPENAI_API_KEY=

# Provedor de LLM ('auto', 'gemini', 'openai' ou 'local')
LLM_PROVIDER=auto
